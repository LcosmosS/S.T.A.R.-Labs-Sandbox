        X = chunk[impute_cols].values
        valid_idx = ~nan_idx
        if valid_idx.sum() > 5:  # Ensure enough valid neighbors
            nbrs = NearestNeighbors(n_neighbors=5, metric='nan_euclidean').fit(X[valid_idx])
            distances, indices = nbrs.kneighbors(X[nan_idx])
            for i, idx in enumerate(nan_idx.index[nan_idx]):
                neighbor_logmass = chunk.iloc[indices[i]]['logmass'].values
                chunk.loc[idx, 'logmass'] = np.nanmean(neighbor_logmass)
                print(f"impute_logmass: Imputed logmass={chunk.loc[idx, 'logmass']:.3f} for objid={chunk.loc[idx, 'objid']}")
        else:
            print("impute_logmass: Not enough valid neighbors for imputation")
    return chunk

