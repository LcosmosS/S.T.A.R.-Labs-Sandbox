# --- 12. Preprocess Clustering Features ---
def preprocess_clustering_features(X_struct, feature_cols):
    log_function("preprocess_clustering_features")
    X_struct = X_struct.copy()
    nan_rows = X_struct.isna().any(axis=1)
    if nan_rows.any():
        print(f"preprocess_clustering_features: Found {nan_rows.sum()} rows with NaN values")
        nbrs = NearestNeighbors(n_neighbors=5, metric='nan_euclidean').fit(X_struct[~nan_rows])
        for idx in X_struct[nan_rows].index:
            distances, indices = nbrs.kneighbors(X_struct.loc[idx].values.reshape(1, -1))
            neighbor_values = X_struct.iloc[indices[0]].values
            X_struct.loc[idx, X_struct.columns] = np.nanmean(neighbor_values, axis=0)
            print(f"preprocess_clustering_features: Imputed for row {idx}")
    return X_struct

